<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#E8F5E9">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#2E7D32"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            android:title="Pilih Jurusan" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Program Jurusan &amp; Kelas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_margin="16dp"
                android:textColor="#2E7D32" />

            <!-- TKJ Section -->
            <LinearLayout
                android:id="@+id/major_tkj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E8F5E9"
                android:layout_marginBottom="12dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teknik Jaringan Komputer (TKJ)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_tkj_11"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelas 11"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#4CAF50" />

                    <Button
                        android:id="@+id/btn_tkj_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelas 12"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#4CAF50" />

                    <Button
                        android:id="@+id/btn_tkj_13"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelas 13"
                        android:backgroundTint="#4CAF50" />

                </LinearLayout>

            </LinearLayout>

            <!-- TKR Section -->
            <LinearLayout
                android:id="@+id/major_tkr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E0F2F1"
                android:layout_marginBottom="12dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teknik Kendaraan Ringan (TKR)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_tkr_11"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelas 11"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#42A5F5" />

                    <Button
                        android:id="@+id/btn_tkr_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelas 12"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#42A5F5" />

                    <Button
                        android:id="@+id/btn_tkr_13"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelas 13"
                        android:backgroundTint="#42A5F5" />

                </LinearLayout>

            </LinearLayout>

            <!-- PBS Section -->
            <LinearLayout
                android:id="@+id/major_pbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFF3E0"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendidikan Bimbingan Konselor (PBS)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#EF6C00"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_pbs_11"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelas 11"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFA726" />

                    <Button
                        android:id="@+id/btn_pbs_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelas 12"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFA726" />

                    <Button
                        android:id="@+id/btn_pbs_13"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelas 13"
                        android:backgroundTint="#FFA726" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>